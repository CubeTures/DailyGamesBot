<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Games</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎲</text></svg>">
<style>
{% include "style.css" %}
</style>
</head>
<body>
  <div class="warning" id="warning">
    <div class="warning-card">
      <div class="emoji" aria-hidden="true">🎲</div>
      <h2>Get your link first</h2>
      <p>Run <code>/play</code> in Discord to get your personal link so we can attribute your scores.</p>
    </div>
  </div>
  <main>
    <header>
      <h1>Daily Games</h1>
      <p class="tagline">Play today's puzzles. We'll tell the group how you did.</p>
    </header>

    <section>
      <div class="section-head games-head">
        <h2>Games</h2>
        <span class="note" id="edit-note" hidden>Click a game once to hide its card, twice to hide its scores too, and again to show it.</span>
        <button type="button" class="icon-btn" id="edit-games" aria-pressed="false" hidden
                aria-label="Choose which games you see" title="Choose which games you see">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.38 3.62a2.12 2.12 0 0 1 3 3L7.37 18.64a2 2 0 0 1-.86.5l-2.87.84a.5.5 0 0 1-.62-.62l.84-2.87a2 2 0 0 1 .5-.86z"/></svg>
        </button>
      </div>
      <div class="games" id="games">
{%- for game in games %}
        <div class="card" data-game="{{ game.name }}" data-hide="shown">
          <div class="card-top">
            {%- if game.icon %}
            <img class="icon" src="{{ game.icon }}" alt="">
            {%- else %}
            <div class="icon mono" aria-hidden="true">{{ game.title[0] }}</div>
            {%- endif %}
            <h3><a class="card-link" href="{{ game.url }}" target="_blank" rel="noopener">{{ game.title }}</a></h3>
            <button type="button" class="icon-btn visibility">
              <svg class="eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="eye-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c4.97 0 8.3 3.6 9.94 6.65a1 1 0 0 1 0 .7 13.2 13.2 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.53 13.53 0 0 0 2.06 11.65a1 1 0 0 0 0 .7C3.7 15.4 7.03 19 12 19a9.74 9.74 0 0 0 5.39-1.61"/><path d="M14.08 14.16a3 3 0 0 1-4.24-4.24"/><path d="m2 2 20 20"/></svg>
              <svg class="ghost" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 10h.01"/><path d="M15 10h.01"/><path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"/></svg>
            </button>
            {%- if roles_enabled %}
            <button type="button" class="ping" aria-pressed="false" hidden
                    aria-label="Get pinged in Discord when someone finishes {{ game.title }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            </button>
            {%- endif %}
          </div>
          {%- if game.description %}
          <p class="desc">{{ game.description }}</p>
          {%- endif %}
          <div class="card-foot">
            <div class="tags">
              {%- if game.reset_timezone %}
              <span class="reset" data-timezone="{{ game.reset_timezone }}" title="Resets on {{ game.reset_timezone }} time">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <span class="zone">{{ game.reset_timezone }}</span>
              </span>
              {%- endif %}
            </div>
            <span class="play">Play</span>
            <span class="hide-level"></span>
          </div>
          <div class="stamp-body"><div class="stamp"><b class="stamp-word"></b><span class="stamp-score"></span></div></div>
        </div>
{%- endfor %}
      </div>
    </section>

    <section>
      <div class="section-head scores-head">
        <h2 id="scores-title">Today's scores</h2>
        <span class="note" id="updated"></span>
        <div class="day-nav">
          <button type="button" id="day-prev" aria-label="Previous day">‹</button>
          <input type="date" id="day-pick" aria-label="Show scores for day">
          <button type="button" id="day-next" aria-label="Next day">›</button>
          <button type="button" id="day-today">Today</button>
        </div>
      </div>
      <div class="boards" id="boards"><p class="empty loading">Loading…</p></div>
    </section>

    <footer class="site-foot">
      Want to add more games? Make a pull request at
      <a href="https://github.com/CubeTures/DailyGamesBot" target="_blank" rel="noopener">github.com/CubeTures/DailyGamesBot</a>
    </footer>
  </main>
  <dialog id="dialog" aria-labelledby="dialog-title">
    <div class="dialog-head">
      <button class="back" type="button" aria-label="Back to all scores" hidden>‹</button>
      <h3 id="dialog-title"></h3>
      <button class="close" type="button" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <div class="message"></div>
      <ol class="ranks" hidden></ol>
    </div>
  </dialog>
<script id="game-titles" type="application/json">{{ game_titles | tojson }}</script>
<script id="resets" type="application/json">{{ resets | tojson }}</script>
<script id="higher-score-wins" type="application/json">{{ higher_score_wins | tojson }}</script>
<script>
{{ game_day_js | safe }}
{% include "discord-markdown.js" %}
{% include "icon-color.js" %}
{% include "app.js" %}
</script>
</body>
</html>
