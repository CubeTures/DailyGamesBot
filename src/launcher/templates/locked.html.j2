<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Games</title>
<link rel="icon" type="image/png" href="{{ favicon }}">
<style>
{% include "style.css" %}
.warning { display: flex; }
</style>
</head>
<body>
  <div class="warning">
    <div class="warning-card">
      <img class="emoji" src="{{ favicon }}" alt="">
      {%- if expired %}
      <h2>Your link has expired</h2>
      <p>Run <code>/play</code> in Discord for a new one.</p>
      {%- else %}
      <h2>Get your link first</h2>
      <p>Run <code>/play</code> in Discord to get your personal link so we can attribute your scores.</p>
      {%- endif %}
    </div>
  </div>
<script>
  // Before the server set a cookie, the page kept the token in localStorage:
  // try it once, then forget it.
  (function () {
    try {
      var token = localStorage.getItem("token");
      if (new URLSearchParams(location.search).has("token")) {
        localStorage.removeItem("token");
        history.replaceState({}, "", location.pathname + location.hash);
      } else if (token) {
        location.replace("/?token=" + encodeURIComponent(token) + location.hash);
      }
    } catch (e) {}
  })();
</script>
</body>
</html>
