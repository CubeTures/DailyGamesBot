<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Games</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎲</text></svg>">
<style>
  :root {
    color-scheme: light dark;
    --bg: #f5f6f8;
    --surface: #ffffff;
    --surface-2: #f0f2f5;
    --border: #e3e6eb;
    --border-strong: #cdd2da;
    --text: #16181d;
    --muted: #646b79;
    --accent: #3f5bd8;
    --accent-soft: rgba(63, 91, 216, 0.1);
    --done: #1f8a4c;
    --done-soft: rgba(31, 138, 76, 0.12);
    --shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 1px 3px rgba(16, 24, 40, 0.06);
    --shadow-hover: 0 4px 8px rgba(16, 24, 40, 0.06), 0 12px 24px rgba(16, 24, 40, 0.08);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0e1014;
      --surface: #171a20;
      --surface-2: #1e222a;
      --border: #262a33;
      --border-strong: #363b47;
      --text: #e9ebf0;
      --muted: #8d93a1;
      --accent: #8ea6ff;
      --accent-soft: rgba(142, 166, 255, 0.12);
      --done: #4cc47f;
      --done-soft: rgba(76, 196, 127, 0.14);
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
      --shadow-hover: 0 8px 24px rgba(0, 0, 0, 0.45);
    }
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  main { max-width: 1040px; margin: 0 auto; padding: 48px 24px 64px; }
  @media (max-width: 600px) { main { padding: 28px 16px 48px; } }

  header { margin-bottom: 36px; }
  .date {
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 { margin: 0; font-size: clamp(1.75rem, 4vw, 2.25rem); letter-spacing: -0.02em; }
  .tagline { margin: 6px 0 0; color: var(--muted); }

  section + section { margin-top: 48px; }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  h2 { margin: 0; font-size: 1.15rem; letter-spacing: -0.01em; }
  .note { color: var(--muted); font-size: 0.8rem; }
  .section-head .note { flex: 1; }

  .day-nav { display: flex; align-items: center; gap: 6px; }
  .day-nav button, .day-nav input {
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
  }
  .day-nav button { min-width: 32px; padding: 0 10px; cursor: pointer; }
  .day-nav input { padding: 0 8px; }
  .day-nav button:hover:not(:disabled) { background: var(--surface-2); border-color: var(--border-strong); }
  .day-nav button:disabled { opacity: 0.4; cursor: default; }
  .day-nav button:focus-visible, .day-nav input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .day-nav [hidden] { display: none; }
  @media (max-width: 600px) {
    .section-head.scores-head { flex-wrap: wrap; }
    .scores-head .day-nav { width: 100%; }
    .scores-head .day-nav input { flex: 1; min-width: 0; }
  }

  .games {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .card:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); border-color: var(--border-strong); }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .card-top { display: flex; align-items: center; gap: 14px; }
  .card h3 { margin: 0; font-size: 1.1rem; }
  .card .desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .card.done .status { background: var(--done-soft); color: var(--done); }
  .play { color: var(--accent); font-size: 0.9rem; font-weight: 600; }
  .play::after { content: " \2192"; display: inline-block; transition: transform 0.15s ease; }
  .card:hover .play::after { transform: translateX(3px); }

  .icon {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    object-fit: cover;
    background: var(--surface-2);
  }
  .icon.small { width: 28px; height: 28px; border-radius: 7px; }
  .mono {
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-size: 1.4rem;
  }
  .icon.small.mono { font-size: 0.9rem; }

  .boards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    align-items: start;
  }
  .board {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .board-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }
  .board-head h3 { margin: 0; font-size: 1rem; flex: 1; }
  .board-head .count { color: var(--muted); font-size: 0.8rem; }
  .board ol { list-style: none; margin: 0; padding: 6px; }
  .board .row {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 7px 10px;
    border: 0;
    border-radius: 9px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.92rem;
    text-align: left;
  }
  .board button.row { cursor: pointer; }
  .board button.row:hover { background: var(--surface-2); }
  .board button.row:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .board li.me .row { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .board .rank { color: var(--muted); font-variant-numeric: tabular-nums; text-align: center; }
  .board .medal { font-size: 1.05rem; }
  .board .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .board .score { font-variant-numeric: tabular-nums; font-weight: 600; }
  .board .score.lost { color: var(--muted); font-weight: 500; }

  dialog {
    width: min(460px, calc(100vw - 32px));
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-hover);
  }
  dialog::backdrop { background: rgba(10, 12, 16, 0.5); }
  .dialog-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }
  .dialog-head h3 { margin: 0; font-size: 1rem; flex: 1; }
  .close {
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover { background: var(--surface-2); color: var(--text); }
  .close:focus-visible { outline: 2px solid var(--accent); }
  .dialog-body { padding: 16px; }
  .dialog-body .note { margin: 0 0 8px; }
  .message {
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--surface-2);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .message .mention {
    padding: 0 3px;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .message code { background: var(--border); }

  .empty {
    padding: 32px 20px;
    border: 1px dashed var(--border-strong);
    border-radius: 16px;
    color: var(--muted);
    text-align: center;
  }

  .warning {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: var(--bg);
  }
  .warning-card {
    max-width: 420px;
    padding: 32px 28px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: var(--shadow-hover);
    text-align: center;
  }
  .warning-card .emoji { font-size: 2.5rem; line-height: 1; }
  .warning-card h2 { margin: 14px 0 8px; font-size: 1.3rem; }
  .warning-card p { margin: 0; color: var(--muted); }
  code {
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text);
    font-size: 0.9em;
  }
</style>
</head>
<body>
  <div class="warning" id="warning">
    <div class="warning-card">
      <div class="emoji" aria-hidden="true">🎲</div>
      <h2>Get your link first</h2>
      <p>Run <code>/play</code> in Discord to get your personal link, so your scores count.</p>
    </div>
  </div>
  <main>
    <header>
      <p class="date" id="date"></p>
      <h1>Daily Games</h1>
      <p class="tagline">Play today's puzzles; your results post to Discord automatically.</p>
    </header>

    <section>
      <div class="section-head"><h2>Games</h2></div>
      <div class="games">
{%- for game in games %}
        <a class="card" data-game="{{ game.name }}" href="http://localhost:{{ game.port }}{{ game.path }}" target="_blank" rel="noopener">
          <div class="card-top">
            {%- if game.icon %}
            <img class="icon" src="{{ game.icon }}" alt="">
            {%- else %}
            <div class="icon mono" aria-hidden="true">{{ game.title[0] }}</div>
            {%- endif %}
            <h3>{{ game.title }}</h3>
          </div>
          {%- if game.description %}
          <p class="desc">{{ game.description }}</p>
          {%- endif %}
          <div class="card-foot">
            <span class="status">Not played</span>
            <span class="play">Play</span>
          </div>
        </a>
{%- endfor %}
      </div>
    </section>

    <section>
      <div class="section-head scores-head">
        <h2 id="scores-title">Today's scores</h2>
        <span class="note" id="updated"></span>
        <div class="day-nav">
          <button type="button" id="day-prev" aria-label="Previous day">‹</button>
          <input type="date" id="day-pick" aria-label="Show scores for day">
          <button type="button" id="day-next" aria-label="Next day">›</button>
          <button type="button" id="day-today">Today</button>
        </div>
      </div>
      <div class="boards" id="boards"><p class="empty">Loading…</p></div>
    </section>
  </main>
  <dialog id="announcement" aria-labelledby="announcement-title">
    <div class="dialog-head">
      <h3 id="announcement-title"></h3>
      <button class="close" type="button" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <div class="message"></div>
    </div>
  </dialog>
<script>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var discordId = params.get("discord_id");
    if (discordId) {
      localStorage.setItem("discord_id", discordId);
      params.delete("discord_id");
      var query = params.toString();
      var newUrl =
        window.location.pathname + (query ? "?" + query : "") + window.location.hash;
      window.history.replaceState({}, "", newUrl);
    } else {
      discordId = localStorage.getItem("discord_id");
    }

    if (discordId) {
      // Games run on other localhost ports, which can't read this page's
      // localStorage but do share its cookies; the proxy reads this one when
      // a game reports a result.
      document.cookie = "dgb_discord_id=" + encodeURIComponent(discordId) +
        "; path=/; max-age=31536000; SameSite=Lax";
    }

    if (!discordId) {
      document.getElementById("warning").style.display = "flex";
    }

    document.getElementById("date").textContent = new Date().toLocaleDateString(
      undefined, { weekday: "long", month: "long", day: "numeric" });

    var gameTitles = {{ game_titles | tojson }};
    var medals = ["\u{1F947}", "\u{1F948}", "\u{1F949}"];

    function title(game) {
      return gameTitles[game] || game;
    }

    function formatScore(d) {
      var score = d.score === null || d.score === undefined ? null : d.score;
      var text;
      if (d.max_score !== undefined && d.max_score !== null) {
        text = (score === null ? "X" : score) + "/" + d.max_score;
      } else {
        text = score === null ? "–" : String(score);
      }
      if (d.won === false && score !== null) text += " ✗";
      return text;
    }

    // Lower is better for every game so far (Wordle guesses, Minute Cryptic
    // help over par); no score (a loss) sorts last, then earliest finish.
    function compare(a, b) {
      var sa = a.data.score, sb = b.data.score;
      var na = typeof sa !== "number", nb = typeof sb !== "number";
      if (na !== nb) return na ? 1 : -1;
      if (!na && sa !== sb) return sa - sb;
      return a.captured_at < b.captured_at ? -1 : 1;
    }

    // Discord shortcodes the announcement templates use; any others show as
    // typed.
    var shortcodes = {
      bee: "🐝", green_square: "🟩", yellow_square: "🟨", white_large_square: "⬜",
      black_large_square: "⬛", purple_square: "🟪", blue_square: "🟦",
      orange_square: "🟧", red_square: "🟥", brown_square: "🟫",
      green_circle: "🟢", yellow_circle: "🟡", red_circle: "🔴", white_circle: "⚪",
      black_circle: "⚫", blue_circle: "🔵", purple_circle: "🟣", orange_circle: "🟠",
      white_check_mark: "✅", x: "❌", trophy: "🏆", first_place: "🥇",
      second_place: "🥈", third_place: "🥉", fire: "🔥", star: "⭐", tada: "🎉",
      stopwatch: "⏱️", clock: "🕐", brain: "🧠", bulb: "💡", skull: "💀",
      game_die: "🎲", puzzle_piece: "🧩", thinking: "🤔", heart: "❤️",
      shrimp: "🦐", fish: "🐟", bubbles: "🫧", squid: "🦑", clown: "🤡",
      izakaya_lantern: "🏮", star2: "🌟"
    };

    function escapeHtml(text) {
      return text.replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    // The subset of Discord markdown announcements use: mentions, shortcodes,
    // `code`, **bold**, __underline__, *italic*/_italic_ and ~~strike~~.
    function discordHtml(text, names) {
      return escapeHtml(text)
        .replace(/&lt;@!?(\d+)&gt;/g, function (_, id) {
          var name = names[id] || "Player …" + id.slice(-4);
          return '<span class="mention">@' + escapeHtml(name) + "</span>";
        })
        .replace(/:([a-z0-9_+-]+):/g, function (m, code) {
          return shortcodes[code] || m;
        })
        .replace(/`([^`\n]+)`/g, "<code>$1</code>")
        .replace(/\*\*([^*\n]+)\*\*/g, "<strong>$1</strong>")
        .replace(/__([^_\n]+)__/g, "<u>$1</u>")
        .replace(/\*([^*\n]+)\*|\b_([^_\n]+)_\b/g, function (_, a, b) {
          return "<em>" + (a || b) + "</em>";
        })
        .replace(/~~([^~\n]+)~~/g, "<s>$1</s>");
    }

    var dialog = document.getElementById("announcement");
    dialog.querySelector(".close").addEventListener("click", function () {
      dialog.close();
    });
    // A click on the backdrop lands on the dialog itself.
    dialog.addEventListener("click", function (e) {
      if (e.target === dialog) dialog.close();
    });

    function showAnnouncement(r, names) {
      var head = dialog.querySelector(".dialog-head");
      var oldIcon = head.querySelector(".icon");
      if (oldIcon) oldIcon.remove();
      head.insertBefore(icon(r.game), head.firstChild);
      document.getElementById("announcement-title").textContent =
        (r.name || "Player …" + r.discord_id.slice(-4)) + " · " + title(r.game);
      dialog.querySelector(".message").innerHTML = discordHtml(r.announcement, names);
      dialog.showModal();
    }

    function el(tag, className, text) {
      var e = document.createElement(tag);
      if (className) e.className = className;
      if (text !== undefined) e.textContent = text;
      return e;
    }

    // The game's card icon, reused at a smaller size.
    function icon(game) {
      var cardIcon = document.querySelector('.card[data-game="' + game + '"] .icon');
      var copy = cardIcon ? cardIcon.cloneNode(true) : el("div", "icon mono", title(game).charAt(0));
      copy.classList.add("small");
      return copy;
    }

    function renderCards(byGame) {
      document.querySelectorAll(".card").forEach(function (card) {
        var mine = (byGame[card.dataset.game] || []).filter(function (r) {
          return r.discord_id === discordId;
        })[0];
        card.classList.toggle("done", !!mine);
        card.querySelector(".status").textContent =
          mine ? "✓ Done · " + formatScore(mine.data) : "Not played";
        card.querySelector(".play").textContent = mine ? "Open" : "Play";
      });
    }

    function renderBoards(byGame, emptyText) {
      var boards = document.getElementById("boards");
      boards.textContent = "";
      var names = Object.keys(byGame).sort(function (a, b) {
        return title(a).localeCompare(title(b));
      });
      if (!names.length) {
        boards.appendChild(el("p", "empty", emptyText));
        return;
      }
      var playerNames = {};
      names.forEach(function (game) {
        byGame[game].forEach(function (r) {
          if (r.name) playerNames[r.discord_id] = r.name;
        });
      });
      names.forEach(function (game) {
        var rows = byGame[game].sort(compare);
        var board = el("div", "board");
        var head = el("div", "board-head");
        head.appendChild(icon(game));
        head.appendChild(el("h3", "", title(game)));
        head.appendChild(el("span", "count",
          rows.length + (rows.length === 1 ? " player" : " players")));
        board.appendChild(head);
        var list = el("ol");
        rows.forEach(function (r, i) {
          var li = el("li", r.discord_id === discordId ? "me" : "");
          var row = el(r.announcement ? "button" : "div", "row");
          if (r.announcement) {
            row.type = "button";
            row.title = "Show the Discord announcement";
            row.addEventListener("click", function () {
              showAnnouncement(r, playerNames);
            });
          }
          var scored = typeof r.data.score === "number" && r.data.won !== false;
          row.appendChild(i < 3 && scored
            ? el("span", "rank medal", medals[i])
            : el("span", "rank", String(i + 1)));
          row.appendChild(el("span", "name", r.name || "Player …" + r.discord_id.slice(-4)));
          row.appendChild(el("span", scored ? "score" : "score lost", formatScore(r.data)));
          li.appendChild(row);
          list.appendChild(li);
        });
        board.appendChild(list);
        boards.appendChild(board);
      });
    }

    function groupByGame(rows) {
      var byGame = {};
      rows.forEach(function (r) { (byGame[r.game] = byGame[r.game] || []).push(r); });
      return byGame;
    }

    // ---- which day the scoreboard shows ------------------------------------
    // viewDay is a local midnight, or null to follow today (also across
    // midnight). Kept in the URL hash as #day=YYYY-MM-DD so it can be linked.
    function startOfDay(d) {
      return new Date(d.getFullYear(), d.getMonth(), d.getDate());
    }
    function addDays(d, n) {
      return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
    }
    function dayKey(d) {
      var pad = function (n) { return (n < 10 ? "0" : "") + n; };
      return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
    }
    function parseDay(key) {
      var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(key || "");
      return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null;
    }

    var viewDay = null;
    var prevBtn = document.getElementById("day-prev");
    var nextBtn = document.getElementById("day-next");
    var todayBtn = document.getElementById("day-today");
    var dayPick = document.getElementById("day-pick");

    function setDay(day, fromHash) {
      var today = startOfDay(new Date());
      viewDay = day && day < today ? day : null;
      if (!fromHash) {
        var hash = viewDay ? "#day=" + dayKey(viewDay) : "";
        history.replaceState({}, "", location.pathname + location.search + hash);
      }
      loadBoards();
    }

    function dayFromHash() {
      return parseDay((/^#day=(.*)$/.exec(location.hash) || [])[1]);
    }

    function fetchResults(since, until) {
      var url = "/api/results?since=" + encodeURIComponent(since.toISOString());
      if (until) url += "&until=" + encodeURIComponent(until.toISOString());
      return fetch(url).then(function (res) { return res.json(); });
    }

    // Today's results drive the game cards' "Done" state whatever day the
    // scoreboard shows, and the scoreboard too while it's on today.
    function renderToday(rows) {
      var byGame = groupByGame(rows);
      renderCards(byGame);
      if (viewDay) return;
      renderBoards(byGame, "Nobody has finished a game yet today. Be the first!");
      document.getElementById("updated").textContent = "Updated " +
        new Date().toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
    }

    function refreshToday() {
      fetchResults(startOfDay(new Date())).then(renderToday).catch(function () {});
    }

    var loadSeq = 0;
    function loadBoards() {
      var today = startOfDay(new Date());
      var day = viewDay || today;
      prevBtn.disabled = false;
      nextBtn.disabled = !viewDay;
      todayBtn.hidden = !viewDay;
      dayPick.max = dayKey(today);
      dayPick.value = dayKey(day);
      document.getElementById("scores-title").textContent = viewDay
        ? "Scores · " + day.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" })
        : "Today's scores";
      document.getElementById("updated").textContent = "";
      if (!viewDay) {
        refreshToday();
        return;
      }
      var seq = ++loadSeq;
      var boards = document.getElementById("boards");
      boards.textContent = "";
      boards.appendChild(el("p", "empty", "Loading…"));
      fetchResults(day, addDays(day, 1)).then(function (rows) {
        // Ignore a slow answer for a day the viewer has already left.
        if (seq !== loadSeq || !viewDay || viewDay.getTime() !== day.getTime()) return;
        renderBoards(groupByGame(rows), "Nobody finished a game that day.");
      }).catch(function () {});
    }

    prevBtn.addEventListener("click", function () {
      setDay(addDays(viewDay || startOfDay(new Date()), -1));
    });
    nextBtn.addEventListener("click", function () {
      if (viewDay) setDay(addDays(viewDay, 1));
    });
    todayBtn.addEventListener("click", function () { setDay(null); });
    dayPick.addEventListener("change", function () {
      var day = parseDay(dayPick.value);
      if (day) setDay(day);
    });
    window.addEventListener("hashchange", function () { setDay(dayFromHash(), true); });

    setDay(dayFromHash(), true);
    if (viewDay) refreshToday();
    setInterval(refreshToday, 30000);
  })();
</script>
</body>
</html>
