{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `python3 -m src.games`; do not edit.",
  "$defs": {
    "EventTrigger": {
      "additionalProperties": false,
      "description": "Checked when `event` fires on `target`.",
      "properties": {
        "name": {
          "description": "Unique within the game; stored with each result.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "when": {
          "default": "true",
          "description": "Truthy means \"the player has finished, report it\". The game's vars.js is in scope.",
          "pattern": "\\S",
          "title": "When",
          "type": "string"
        },
        "type": {
          "const": "event",
          "title": "Type",
          "type": "string"
        },
        "event": {
          "description": "DOM event name.",
          "minLength": 1,
          "title": "Event",
          "type": "string"
        },
        "target": {
          "default": "window",
          "enum": [
            "window",
            "document"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "event"
      ],
      "title": "EventTrigger",
      "type": "object"
    },
    "NetworkTrigger": {
      "additionalProperties": false,
      "description": "Checked after each fetch/XHR response whose URL matches `url`.",
      "properties": {
        "name": {
          "description": "Unique within the game; stored with each result.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "when": {
          "default": "true",
          "description": "Truthy means \"the player has finished, report it\". The game's vars.js is in scope.",
          "pattern": "\\S",
          "title": "When",
          "type": "string"
        },
        "type": {
          "const": "network",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "description": "Regex, searched against the request URL.",
          "format": "regex",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only match this HTTP method.",
          "title": "Method"
        }
      },
      "required": [
        "name",
        "type",
        "url"
      ],
      "title": "NetworkTrigger",
      "type": "object"
    },
    "PageTrigger": {
      "additionalProperties": false,
      "description": "Checked on page load, DOM mutations, storage writes, after any\nfetch/XHR, and every second.",
      "properties": {
        "name": {
          "description": "Unique within the game; stored with each result.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "when": {
          "default": "true",
          "description": "Truthy means \"the player has finished, report it\". The game's vars.js is in scope.",
          "pattern": "\\S",
          "title": "When",
          "type": "string"
        },
        "type": {
          "const": "page",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "PageTrigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "Must match the game's directory name.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "title": {
      "description": "Shown on the launcher. Defaults to the name.",
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A line or two about the game, shown on the launcher.",
      "title": "Description"
    },
    "icon": {
      "anyOf": [
        {
          "pattern": "^[\\w.-]+(\\.png|\\.svg|\\.webp|\\.jpg|\\.jpeg)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Image file in the game's directory, shown on the launcher; square, at least 128px. Defaults to the title's first letter.",
      "title": "Icon"
    },
    "origin": {
      "description": "The real site, proxied 1:1.",
      "pattern": "^https?://",
      "title": "Origin",
      "type": "string"
    },
    "port": {
      "description": "Unique local port (8090 is the launcher's).",
      "maximum": 65535,
      "minimum": 1024,
      "title": "Port",
      "type": "integer"
    },
    "landing_path": {
      "default": "/",
      "pattern": "^/",
      "title": "Landing Path",
      "type": "string"
    },
    "higher_score_wins": {
      "default": false,
      "description": "Rank the scoreboard by highest `score` first. By default the lowest score (fewest guesses, mistakes) ranks first.",
      "title": "Higher Score Wins",
      "type": "boolean"
    },
    "triggers": {
      "description": "Each says when the player has finished and what to report. They share the game's vars.js and fields.js. A game with no triggers is still proxied, just not captured.",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "event",
              "network",
              "page"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "event"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/EventTrigger"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "network"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/NetworkTrigger"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "page"
                }
              }
            },
            "then": {
              "$ref": "#/$defs/PageTrigger"
            }
          }
        ]
      },
      "title": "Triggers",
      "type": "array"
    }
  },
  "required": [
    "name",
    "origin",
    "port"
  ],
  "title": "Game config",
  "type": "object"
}
