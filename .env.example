DISCORD_BOT_TOKEN=
# Channels to announce finished games in, at most one per server, separated
# by commas (right-click each > Copy Channel ID). A channel ID also names its
# server, so no server IDs are needed. A result is posted in each of these
# servers that its player has registered with by running /play there. Leave
# empty to not announce. The bot also creates a role per game in each of these
# servers (it needs the Manage Roles permission); players pick roles on the
# launcher and get pinged when someone finishes that game. The older
# DISCORD_RESULTS_CHANNEL_ID still works when this is unset.
DISCORD_RESULTS_CHANNEL_IDS=
# A channel for admins. When set, the bot runs the unit and live tests every
# day at 12:00 UTC and, only if any fail, posts them here with the pytest
# output and the live tests' screenshots and logs attached. Needs the dev
# dependencies (uv sync) and Chrome installed: in Docker, use the -with-tests
# image (Dockerfile.with-tests), not the plain one.
DISCORD_ADMIN_CHANNEL_ID=
# Where players reach the launcher; each game is served from a subdomain of it
# (wordle.localhost:8080). Default: http://localhost:8080. In production, use a
# domain with wildcard DNS (*.games.example.com) behind a TLS-terminating
# reverse proxy that forwards every host to the proxy's port, keeping the Host
# header, e.g. https://games.example.com.
DGB_PUBLIC_URL=
# The port the proxy listens on. Default: the public URL's port, else 8080.
DGB_PROXY_PORT=
# Each game's host, with {game} for its name. Default: a subdomain of the
# public URL ({game}.games.example.com). Set it when nested subdomains can't
# get a certificate, e.g. behind Cloudflare, whose free one only covers
# *.example.com: {game}-games.example.com.
DGB_GAME_HOST=
