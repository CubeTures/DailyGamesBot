DISCORD_BOT_TOKEN=
# Channel to announce finished games in (right-click it > Copy Channel ID).
# Leave empty to not announce. The bot also creates a role per game in this
# channel's server (it needs the Manage Roles permission); players pick roles
# on the launcher and get pinged when someone finishes that game.
DISCORD_RESULTS_CHANNEL_ID=
# Where players reach the launcher; each game is served from a subdomain of it
# (wordle.localhost:8080). Default: http://localhost:8080. In production, use a
# domain with wildcard DNS (*.games.example.com) behind a TLS-terminating
# reverse proxy that forwards every host to the proxy's port, keeping the Host
# header, e.g. https://games.example.com.
DGB_PUBLIC_URL=
# The port the proxy listens on. Default: the public URL's port, else 8080.
DGB_PROXY_PORT=
# Each game's host, with {game} for its name. Default: a subdomain of the
# public URL ({game}.games.example.com). Set it when nested subdomains can't
# get a certificate, e.g. behind Cloudflare, whose free one only covers
# *.example.com: {game}-games.example.com.
DGB_GAME_HOST=
